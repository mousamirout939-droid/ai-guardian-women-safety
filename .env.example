# Copy this file to .env and fill in real values before running docker-compose
# or the server locally. Never commit the real .env file.

# --- App ---
APP_NAME=AI Guardian Women Safety 
ENV=development
DEBUG=true

# --- Security / JWT ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=guardian_shield

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=https://ai-guardian-women-safety.vercel.app,https://ai-guardian-women-safety.onrender.com,http://localhost:5173,http://localhost:3000,http://localhost:80

# --- AI thresholds ---
GESTURE_CONFIDENCE_THRESHOLD=0.7
OBJECT_DETECTION_CONFIDENCE=0.45
SCREAM_PROBABILITY_THRESHOLD=0.6

# --- Optional SMS delivery for manual SOS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_APP_URL=http://localhost:5173
SOS_ESCALATION_DELAY_SECONDS=60
SOS_POLICE_HELPLINE=
SOS_TRACKING_EXPIRY_HOURS=24
